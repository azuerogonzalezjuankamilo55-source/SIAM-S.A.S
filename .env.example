# SIAM - Variables de Entorno
# Copia este archivo como .env y completa los valores

# Flask
FLASK_ENV=development

# Seguridad (genera una clave fuerte con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=genera-una-clave-segura-aqui

# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:password@host:puerto/database?sslmode=require

# URL pública (para SEO, sitemap, etc.)
APP_URL=https://tudominio.com

# Rate limiting (opcional, usar Redis en producción)
RATELIMIT_STORAGE_URI=memory://

# Geolocalización del taller (sede principal) — usada por el mapa de clientes
# en camino y el portal. WORKSHOP_LATITUDE/LONGITUDE son las coordenadas del
# punto de la dirección WORKSHOP_ADDRESS (verificadas en OSM).
WORKSHOP_ADDRESS=Cl. 26 Sur #3c Sur10 No 5B, Soacha, Cundinamarca, Colombia
WORKSHOP_LATITUDE=4.5712283
WORKSHOP_LONGITUDE=-74.2390573

# Rutas (distancias/ETA reales): servidor público de OSRM. Opcional: si tienes
# una instancia propia (router.project-osrm.org por defecto), configúrala aquí.
# Con OSRM_BASE_URL vacío, el mapa sigue funcionando con marcadores y el panel
# muestra el aviso "rutas no disponibles" (sin datos inventados).
OSRM_BASE_URL=https://router.project-osrm.org
