# SIAM - Variables de Entorno
# Copia este archivo como .env y completa los valores

# Flask
FLASK_ENV=development

# Seguridad (genera una clave fuerte con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=genera-una-clave-segura-aqui

# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:password@host:puerto/database?sslmode=require

# URL pública (para SEO, sitemap, etc.)
APP_URL=https://tudominio.com

# Rate limiting (opcional, usar Redis en producción)
RATELIMIT_STORAGE_URI=memory://
